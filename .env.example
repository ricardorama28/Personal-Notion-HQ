# Notion (PERSONAL HQ - 10 DB)
NOTION_TOKEN=
TASKS_DB_ID=35ff24c6187e80e4b0d0c273299b3cdc
EVENTS_DB_ID=35ff24c6187e80609468f54e2fbc1306
PROJECTS_DB_ID=35ff24c6187e803ea6d1ea04bc1e6e63
NOTES_DB_ID=da6ad156266a400581a9441bfb61d301
EXPENSES_DB_ID=4a9e0123f3574134939143262270e24f
MEALS_DB_ID=004586e26d92423aaf36391b0802dee9
HABITS_DB_ID=c5b4258e6d0e4fd59ab3ed2ebf4dd127
HABITLOG_DB_ID=bab93c4040ee437c9a0ca7892c036a91
INBOX_DB_ID=8e64c679cda84546b60a0c7121f56cd8

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Router de costo (Fase B). ROUTER_MODEL = clasificador barato.
# ORCHESTRATOR_MODEL = modelo "fuerte" para el agente cuando se escala.
ROUTER_MODEL=claude-haiku-4-5-20251001
ORCHESTRATOR_MODEL=claude-sonnet-4-6
ROUTER_ENABLED=true
ROUTER_CONFIDENCE_THRESHOLD=0.7

# Twilio / WhatsApp
MY_WHATSAPP=whatsapp:+54XXXXXXXXXX
# Auth token de Twilio (Console > Account > Auth Token). Necesario para validar firma.
TWILIO_AUTH_TOKEN=
# true en produccion (Railway/PC propia con tunel). false solo para tests locales o curl manual.
TWILIO_VALIDATE=true

# Token compartido para /health/internal y /diag. Si esta vacio, esos
# endpoints devuelven 404 (deshabilitados). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Persistencia (Fase C)
# Backend de sesiones: "file" (default, /tmp JSON) o "postgres"
SESSIONS_BACKEND=file
# SQLAlchemy async URL. Requerida si SESSIONS_BACKEND=postgres.
# Ej Postgres prod: postgresql+asyncpg://wpp:pass@localhost:5432/wpp
# Ej tests:        sqlite+aiosqlite:///:memory:
DATABASE_URL=
# TTL para confirmaciones pendientes (Fase F).
CONFIRMATION_TTL_MINUTES=10

# Opcional / runtime. Si no se setean, se usan /data/* cuando /data existe
# (volumen Docker) o /tmp/* en caso contrario (Railway, dev local).
SESSIONS_FILE=
COST_LOG_FILE=
MAX_TOOL_ITERATIONS=8
HISTORY_WINDOW=30
MAX_BODY_BYTES=4096

# --- Docker Compose (Fase D) ---
# Credenciales del contenedor postgres. Cambia POSTGRES_PASSWORD SIEMPRE.
# Si SESSIONS_BACKEND=postgres y usas compose, DATABASE_URL la arma compose:
#   postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_USER=wpp
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=wpp
# Puerto en el HOST donde se expone el servicio web (el contenedor escucha 8000).
WEB_PORT=8000
